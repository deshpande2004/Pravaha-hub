{
  "name": "pravahaxsuite",
  "productName": "Pravahax Suite",
  "version": "1.2.1",
  "description": "Pravahax Suite desktop app for Windows",
  "author": "Pravahax Suite",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.2",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.pravahaxsuite.desktop",
    "win": { "executableName": "PravahaxSuite" },
    "productName": "Pravahax Suite",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "afterPack": "./afterPack.js",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "PravahaxSuite-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pravahax Suite",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PravahaxSuite-Setup-${version}.${ext}",
      "warningsAsErrors": false,
      "installerLanguages": [
        "en_US"
      ],
      "multiLanguageInstaller": false
    },
    "portable": {
      "artifactName": "PravahaxSuite-Portable-${version}.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "PravahaxSuite-${version}-mac-${arch}.${ext}"
    }
  }
}
